<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="at.htl.android_frontend.overview.OverviewViewModel" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contraint_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/forest_path"
        tools:context="at.htl.android_frontend.MainActivity">
        <TextView
            android:id="@+id/pick_path_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pick_a_path"
            android:textSize="20sp"
            android:textColor="#000000"
            android:background="#99FFFFFF"
            android:gravity="center"
            tools:text="Pick Path"
            android:layout_marginStart="13.8dp"
            android:layout_marginEnd="13.8dp"
            android:layout_marginTop="10sp"
            app:layout_constraintTop_toTopOf="@id/contraint_layout"
            app:layout_constraintLeft_toLeftOf="@id/contraint_layout"
            app:layout_constraintRight_toRightOf="@id/contraint_layout"
            />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/path_grid"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="6dp"
            android:clipToPadding="false"
            android:layout_marginTop="10sp"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintBottom_toBottomOf="@id/contraint_layout"
            app:layout_constraintLeft_toLeftOf="@id/contraint_layout"
            app:layout_constraintRight_toRightOf="@id/contraint_layout"
            app:layout_constraintTop_toBottomOf="@id/pick_path_id"
            app:listData="@{viewModel.property}"
            app:spanCount="1"
            tools:itemCount="16"
            tools:listitem="@layout/grid_view_item" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>