<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="property"
            type="at.htl.android_frontend.network.Checkpoint" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/checkpoint_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadingEdge="vertical"
            app:cardBackgroundColor="#99FFFFFF"
            app:contentPaddingBottom="5sp"
            app:contentPaddingTop="5sp"
            android:layout_margin="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:cardCornerRadius="@dimen/cardview_default_radius">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10sp"
                android:layout_marginBottom="10sp">
                <TextView
                    android:id="@+id/checkpoint_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{property.name}"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5sp"
                    android:layout_marginStart="5sp"
                    tools:text="Checkpoint Name"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/checkpoint_location"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
                <TextView
                    android:id="@+id/checkpoint_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5sp"
                    android:lineSpacingExtra="5sp"
                    android:textColor="#000000"
                    android:textSize="13sp"
                    app:layout_constraintStart_toEndOf="@id/checkpoint_name"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    tools:text="HTL-Leonding"
                    android:text="@{property.cpLocation}" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>